{
  "name": "singularity-dsh-plugin",
  "version": "2.2.4",
  "private": false,
  "description": "AI 时代的社会形态演化模拟：可交互的历史推演器，作为 DeepSeek Harness 中的一个全宽面板",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "simulation",
    "political-economy",
    "ai",
    "ui"
  ],
  "license": "MIT",
  "author": "TEN.GH <tengsha@gmail.com>",
  "homepage": "https://github.com/naturalth2012/singularity-dsh-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naturalth2012/singularity-dsh-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/naturalth2012/singularity-dsh-plugin/issues"
  },
  "type": "module",
  "icon": "icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.snapshot.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "docs/DETAIL.md",
    "README.md",
    "PUBLISHING.md",
    "MODEL-CONTRACT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "preflight": "node scripts/preflight.cjs",
    "check:contract": "node scripts/contract-check.cjs",
    "pack-check": "node scripts/pack-check.cjs",
    "set-repo": "node scripts/set-repo.cjs",
    "counts": "node scripts/collect-counts.cjs --write-docs",
    "engine:extract": "node scripts/extract-engine.cjs",
    "calibrate": "node scripts/calibrate.cjs && node scripts/inject-calibration.cjs",
    "i18n": "node scripts/inject-locale.cjs && node scripts/inject-translations.cjs",
    "i18n:audit": "node scripts/i18n-audit.cjs",
    "i18n:probe": "node scripts/i18n-probe.cjs",
    "audit": "node scripts/audit-probe.cjs && node scripts/audit-probe2.cjs",
    "market": "node scripts/make-market-entry.cjs",
    "test": "node tests/engine.test.cjs && node tests/adversarial.test.cjs && node tests/mount.test.cjs && node tests/deeptab.test.cjs",
    "verify": "node scripts/contract-check.cjs && node tests/engine.test.cjs && node tests/adversarial.test.cjs && node tests/mount.test.cjs && node tests/deeptab.test.cjs && node scripts/preflight.cjs && node scripts/i18n-probe.cjs && node scripts/realreact-probe.cjs && node scripts/i18n-cjk-scan.cjs && node scripts/i18n-data-audit.cjs",
    "pack": "npm pack",
    "render:probe": "node scripts/render-probe.cjs",
    "render:real": "node scripts/realreact-probe.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
